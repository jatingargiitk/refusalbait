  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
